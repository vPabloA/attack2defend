# Attack2Defend AI Cherry Picker
# North Star: Full traceability, curated decision.
# The UI must never call public APIs or LLM providers directly.
# LLM output is only a candidate; curated-route validators always win.

# disabled | deterministic | llm
A2D_CHERRY_PICKER_MODE=deterministic

# gemini | openai | anthropic
A2D_AI_PROVIDER=gemini

# Cost-effective defaults for offline/build-time curation.
# Gemini: cheapest functional default for batch/offline cherry-picking.
A2D_GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Optional override for tests/private gateways only.
# A2D_GEMINI_ENDPOINT_TEMPLATE=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}

# OpenAI: cheapest fallback for classification / constrained JSON selection.
A2D_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# A2D_OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses

# Anthropic: cost-conscious Claude fallback; use Sonnet only for premium/manual runs.
A2D_ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_KEY=
# A2D_ANTHROPIC_MESSAGES_ENDPOINT=https://api.anthropic.com/v1/messages
# A2D_ANTHROPIC_PREMIUM_MODEL=claude-sonnet-4-5

# Guardrails
A2D_CHERRY_PICKER_TEMPERATURE=0
A2D_CHERRY_PICKER_MAX_OUTPUT_TOKENS=4000
A2D_CHERRY_PICKER_TIMEOUT_SECONDS=60
A2D_CHERRY_PICKER_REQUIRE_VALIDATION=true
A2D_CHERRY_PICKER_CACHE_RESULTS=true
A2D_CHERRY_PICKER_ALLOW_EXTERNAL_KNOWLEDGE=false
A2D_CHERRY_PICKER_RUNTIME_PUBLIC_API_CALLS=false

# Hard limits enforced by schema + validator
A2D_CURATED_MAX_CVE=1
A2D_CURATED_MAX_CWE=3
A2D_CURATED_MAX_CAPEC=6
A2D_CURATED_MAX_ATTACK=8
A2D_CURATED_MAX_D3FEND=6
